From dc514267bcac8dfa4be3263e1d7552d9dbc3e78e Mon Sep 17 00:00:00 2001
From: scy-linth <scylinthgaming@gmail.com>
Date: Tue, 27 Jan 2026 19:11:24 +0800
Subject: [PATCH] button add to cart fix animation

---
 frontend/css/styles.css | 17 ++++++++++++-----
 1 file changed, 12 insertions(+), 5 deletions(-)

diff --git a/frontend/css/styles.css b/frontend/css/styles.css
index ade05fe..b8aa1d2 100644
--- a/frontend/css/styles.css
+++ b/frontend/css/styles.css
@@ -1539,16 +1539,23 @@ body.loading {
     background: var(--primary-color);
     color: var(--white);
     border: none;
-        padding: 0.75rem 1.5rem;
+    padding: 0.75rem 1.5rem;
     border-radius: var(--border-radius);
     font-weight: 500;
     cursor: pointer;
-    transition: var(--transition);
+    transition: var(--transition), box-shadow 0.2s, transform 0.2s;
     margin-top: auto;
-}
-    transition: transform 0.2s cubic-bezier(0.4,0,0.2,1), box-shadow 0.2s;
     position: relative;
-    z-index: 1;
+    z-index: 2;
+    box-shadow: 0 2px 8px rgba(74, 222, 128, 0.10);
+}
+}
+.add-to-cart-btn:hover, .add-to-cart-btn:focus {
+    background: var(--secondary-color);
+    color: var(--primary-color);
+    transform: scale(1.06);
+    box-shadow: 0 6px 18px rgba(74, 222, 128, 0.18), 0 1.5px 6px rgba(0,0,0,0.08);
+    outline: none;
 }
 
 @keyframes addToCartPulse {
